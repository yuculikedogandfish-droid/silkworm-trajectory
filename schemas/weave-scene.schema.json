{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "silkworm-weave-scene/v1",
  "title": "Weave Scene",
  "description": "蚕簇场景。cells 是几何真源（mm）；SDF 由 cells 派生；同一 config + seed 必须能像素级复现。",
  "type": "object",
  "required": ["schema", "config", "screen", "cells"],
  "properties": {
    "schema": { "const": "silkworm-weave-scene/v1" },
    "generator": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["areaM2", "aspectW", "aspectH", "pitchMM", "cols", "rows", "strata", "coverage", "worms", "seed"],
      "properties": {
        "areaM2": { "type": "number", "exclusiveMinimum": 0, "description": "屏体面积，7.4 时为实际展陈尺寸" },
        "aspectW": { "type": "number", "exclusiveMinimum": 0 },
        "aspectH": { "type": "number", "exclusiveMinimum": 0 },
        "pitchMM": { "type": "number", "exclusiveMinimum": 0, "description": "像素间距，P1.5 = 1.5" },
        "cols": { "type": "integer", "minimum": 2, "maximum": 24 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 18 },
        "marginPct": { "type": "number", "minimum": 0, "maximum": 15 },
        "strata": { "type": "integer", "minimum": 1, "maximum": 12 },
        "coverage": { "type": "number", "minimum": 0.02, "maximum": 0.98, "description": "目标覆盖率的基准值" },
        "worms": { "type": "integer", "minimum": 1, "maximum": 6, "description": "每格每层蚕数" },
        "seed": { "type": "integer" },
        "loopAmp": { "type": "number" },
        "wallAff": { "type": "number", "minimum": 0, "maximum": 1 },
        "duration": { "type": "number", "description": "生长动画时长（秒）" }
      }
    },
    "screen": {
      "type": "object",
      "required": ["widthMM", "heightMM", "nativePx", "pitchMM"],
      "properties": {
        "widthMM": { "type": "number" },
        "heightMM": { "type": "number" },
        "pitchMM": { "type": "number" },
        "nativePx": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "safeAreaPct": { "type": "number", "default": 2, "description": "四周安全边比例，重要构图不贴边" }
      }
    },
    "profile": { "type": "object", "description": "引用的 worm-profile，或内联指纹" },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "w", "h", "type"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" }, "y": { "type": "number" },
          "w": { "type": "number" }, "h": { "type": "number" },
          "type": { "enum": ["plain", "notch", "island", "notchIsland", "merged"] },
          "notch": {
            "type": ["object", "null"],
            "properties": {
              "corner": { "type": "integer", "minimum": 0, "maximum": 3 },
              "cx": { "type": "number" }, "cy": { "type": "number" }, "r": { "type": "number" }
            }
          },
          "island": {
            "type": ["object", "null"],
            "properties": {
              "cx": { "type": "number" }, "cy": { "type": "number" }, "r": { "type": "number" }
            }
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "edge": { "type": "integer", "minimum": 0, "maximum": 3 },
                "from": { "type": "number" }, "to": { "type": "number" }
              }
            },
            "description": "壁上留的导引口；开口处应提高丝密度"
          },
          "targetCoverage": { "type": "number", "minimum": 0.02, "maximum": 0.98 },
          "stratum": { "type": "integer", "minimum": 0 },
          "seed": { "type": "integer" }
        }
      }
    },
    "note": { "type": "string" }
  }
}
